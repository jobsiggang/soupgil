{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path(.+)",
      "destination": "/api/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@vite-api-url",
    "MONGODB_URI": "@mongodb-uri",
    "KAKAO_REST_API_KEY": "@kakao-rest-api-key"
  }
}
